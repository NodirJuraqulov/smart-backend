NODE_ENV=production
PORT=5000

DB_HOST=<production DB host>
DB_PORT=3306
DB_NAME=stoyanka_db
DB_USER=<production DB user>
DB_PASSWORD=<KUCHLI, TASODIFIY PAROL — bu yerga yozilmaydi, deploy paytida generatsiya qilinadi>
DB_POOL_MIN=2
DB_POOL_MAX=20

JWT_SECRET=<64+ belgili tasodifiy hex string — deploy paytida generatsiya qilinadi, masalan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# 32-byte (64 hex char) key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<32 baytli hex, xuddi shunday generatsiya qilinadi>

CORS_ORIGIN=https://sizning-domeningiz.uz

PYTHON_OCR_URL=http://localhost:8000
# s-python'dagi INTERNAL_API_KEY bilan AYNAN BIR XIL bo'lishi shart.
INTERNAL_API_KEY=<s-python bilan bir xil tasodifiy kalit>

UPLOADS_MAX_SIZE_MB=2000

PLATFORM_DEFAULT_TIMEZONE=Asia/Tashkent
